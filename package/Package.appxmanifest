<?xml version="1.0" encoding="utf-8"?>
<!-- sfexpa-xbox (Recompilaciones) — el manifiesto del paquete UWP.

     CÁMBIALO antes de compilar: tres datos son de quien firma, y si el Publisher no es exactamente el
     sujeto del certificado con que firmas, MSBuild falla al final de la compilación entera.

       · Identity Name          el nombre del paquete. Pon el tuyo.
       · Identity Publisher     tiene que ser IDÉNTICO al sujeto de tu certificado, letra por letra
                                (lo ves con: Get-ChildItem Cert:\CurrentUser\My | Format-List Subject, Thumbprint).
       · PhoneProductId         un GUID propio: [guid]::NewGuid() en PowerShell.
       · PublisherDisplayName, DisplayName y Description: lo que quieras que lea la consola.

     Version la pone tools\construir-uwp.ps1 con su -Version; no hace falta tocarla aquí.
     Los mosaicos de Assets\ los pones tú: docs/ASSETS.es.md dice cuáles y de qué tamaño.
     docs/INSTALL.es.md §5 y §6 lo explican paso a paso. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap mp rescap">

  <Identity Name="CHANGE-ME-SFEXPlusAlpha"
            Publisher="CN=CHANGE-ME"
            Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="00000000-0000-0000-0000-000000000001" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Street Fighter EX Plus Alpha Recomp</DisplayName>
    <PublisherDisplayName>CHANGE-ME</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="StreetFighterEXPlusAlphaRecomp.exe"
                 EntryPoint="StreetFighterEXPlusAlphaRecomp.App">
      <uap:VisualElements DisplayName="Street Fighter EX Plus Alpha Recomp"
                          Description="Street Fighter EX Plus Alpha (PlayStation, SLUS-00548) recompilado: plusalpha-recomp de guimaraf. Pide tu BIOS SCPH-1001 y tu disco."
                          BackgroundColor="#000000"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
